# ─────────────────────────────────────────
# Copy this file to .env.local and fill in
# your values before running the project.
# ─────────────────────────────────────────

# Database (MySQL / XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=maize_detection_systemai
DB_PORT=3306

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_MAIZE_API_URL=http://localhost:5000

# JWT secret — change this to a long random string in production
JWT_SECRET=change_this_to_a_random_secret_key

# Server port
PORT=3000
